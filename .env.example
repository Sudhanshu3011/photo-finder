# Cloudinary CDN credentials (get from your Cloudinary dashboard)
# Example: cloudinary://<api_key>:<api_secret>@<cloud_name>
DEFAULT_CLOUDINARY_URL=

# Optional Hugging Face Token (if accessing gated models)
HF_TOKEN=

# Concurrency & Performance settings
MAX_CONCURRENT_INFERENCES=2
MAX_FILES_PER_UPLOAD=50
USE_ASYNC_UPLOADS=1

# Multi-Tenant Database & Redis (Phase 1)
# PostgreSQL connection with Row-Level Security (RLS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visual_search
# Redis instance for distributed state & jobs (falls back to in-memory store if empty)
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT Security
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# FAISS Vector Storage Directory (Partitioned per tenant: data/faiss/{tenant_id}/)
FAISS_DATA_DIR=data/faiss

